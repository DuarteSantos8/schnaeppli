# Copy to .env and fill in. Never commit .env.
# Secrets (encryption key, Telegram bot token, eBay keys) live in ./secrets/*, not here.

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# The URL you open Schnäppli at (used for cookies, links in Telegram messages).
SCHNAEPPLI_PUBLIC_URL=https://schnaeppli.example.internal

# Strongly recommended: the first (admin) account can only be created with this token.
# Generate with: openssl rand -hex 16. Remove it after setup if you like.
SCHNAEPPLI_SETUP_TOKEN=

# Who may register after the first (admin) account: invite | open | closed
SCHNAEPPLI_REGISTRATION_MODE=invite

# Defence in depth: only these networks may use the app (comma separated CIDRs).
# Set this to your LAN and VPN ranges. Empty = no in-app restriction.
SCHNAEPPLI_ALLOWED_NETWORKS=
# Reverse proxies whose X-Forwarded-For is trusted (Docker networks + localhost).
SCHNAEPPLI_TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12

SCHNAEPPLI_DEFAULT_TIMEZONE=Europe/Zurich
SCHNAEPPLI_DEFAULT_CURRENCY=CHF

# Telegram bot username without @ (token goes into secrets/telegram_bot_token)
SCHNAEPPLI_TELEGRAM_BOT_USERNAME=

# eBay Browse API marketplace: EBAY_CH, EBAY_DE, EBAY_AT, ...
SCHNAEPPLI_EBAY_MARKETPLACE=EBAY_CH

# Optional: Claude Code bridge on the admin's own machine (see docs/claude-code.md).
# The secret goes into secrets/claude_code_bridge_secret.
SCHNAEPPLI_CLAUDE_CODE_BRIDGE_URL=

# Optional shared AI provider configured by the admin via environment
# (alternatively add a shared key in the app under Settings → AI).
SCHNAEPPLI_SHARED_AI_PROVIDER=
SCHNAEPPLI_SHARED_AI_MODEL=

# Where the web container listens. Keep it on a private address.
SCHNAEPPLI_BIND=127.0.0.1:8080
# Docker network your reverse proxy uses.
SCHNAEPPLI_PROXY_NETWORK=schnaeppli-proxy

BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
# How often to dump the database (hours, aligned to BACKUP_HOUR). 6 = four times a day.
BACKUP_INTERVAL_HOURS=24
